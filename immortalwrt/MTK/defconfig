# ImmortalWrt defconfig for BananaPi BPI-R4 -- core only, no applications.
#
# TEMPORARY.  The workflow builds immortalwrt/MTK/defconfig, so this file is
# trimmed in place to warm the cachewrtbuild toolchain cache: the full build can
# then restore it and skip the toolchain and host tools.  Restore the full config
# with
#
#     git checkout <commit before this one> -- immortalwrt/MTK/defconfig
#
# Same target, toolchain and kernel options as the full config, plus the kernel
# modules and the handful of platform packages, and nothing else; every
# application package is left to the full build.  Keep in step with it: target +
# toolchain + kernel options, kmod-* packages, platform packages.

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TOOLCHAINOPTS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=8192
CONFIG_IPV6=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
CONFIG_PACKAGE_firewall4=y
