# chasey-dev 25.12-dev-wifi7 / BPI-R4

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_bananapi_bpi-r4=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TOOLCHAINOPTS=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=8192
CONFIG_UNETD_VXLAN_SUPPORT=y
CONFIG_VPNC_GNUTLS=y
CONFIG_ZRAM_DEF_COMP_LZORLE=y
CONFIG_IPV6=y
CONFIG_DRIVER_11AC_SUPPORT=y
CONFIG_DRIVER_11AX_SUPPORT=y
CONFIG_DRIVER_11BE_SUPPORT=y
# Keep the upstream mt76/mt7996 path out of the vendor WiFi7 build.
# CONFIG_PACKAGE_kmod-mt7996-firmware is not set
# CONFIG_PACKAGE_kmod-mt7996-233-firmware is not set

# nftables firewall
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# --- WiFi7 ---
CONFIG_PACKAGE_kmod-cfg80211=y
# CONFIG_PACKAGE_kmod-mac80211 is not set
CONFIG_PACKAGE_mt_wifi7=y
CONFIG_PACKAGE_mt_hwifi=y
CONFIG_PACKAGE_warp=y
CONFIG_PACKAGE_wifi-profile=y
# CONFIG_PACKAGE_kmod-mt7996-firmware is not set
# CONFIG_PACKAGE_kmod-mt7992-firmware is not set

# --- HNAT ---
CONFIG_PACKAGE_kmod-mediatek_hnat=y
CONFIG_KERNEL_NET_MEDIATEK_HNAT=y
CONFIG_KERNEL_MEDIATEK_NETSYS_V3=y
# CONFIG_KERNEL_MEDIATEK_NETSYS_V2 is not set

# --- NPU ---
# not available as kmod; integrated via kernel patches
# CONFIG_PACKAGE_kmod-npu is not set

# --- Platform tools ---
CONFIG_PACKAGE_mii_mgr=y
CONFIG_PACKAGE_regs=y
CONFIG_PACKAGE_switch=y
CONFIG_PACKAGE_pce=y
CONFIG_PACKAGE_mtkhnat_util=y
CONFIG_PACKAGE_ethswbox=y
CONFIG_PACKAGE_flowtable=y
CONFIG_PACKAGE_tops-tool=y

# --- Basic system ---
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_xz-utils=y

# --- LuCI minimal ---
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
