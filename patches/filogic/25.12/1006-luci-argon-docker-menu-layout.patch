From: MedyMa <75345465+MedyMa@users.noreply.github.com>
Subject: [PATCH] argon: retain Docker overlay layout in Services

Apply the existing Docker overlay positioning to the upstream Services
routes too. The native Services action buttons already have their layout.

diff --git a/package/community/luci-theme-argon/less/pages/dockerman.less b/package/community/luci-theme-argon/less/pages/dockerman.less
--- a/package/community/luci-theme-argon/less/pages/dockerman.less
+++ b/package/community/luci-theme-argon/less/pages/dockerman.less
@@ -72,6 +72,8 @@
 
 // Dockerman appends its own overlay styles after the theme. Scope these rules
 // to its pages so positioning wins without changing the native show/hide state.
+[data-page="admin-services-dockerman"],
+[data-page^="admin-services-dockerman-"],
 [data-page="admin-docker"],
 [data-page^="admin-docker-"] {
     #docker_apply_overlay {
diff --git a/package/community/luci-theme-argon/htdocs/luci-static/argon/css/cascade.css b/package/community/luci-theme-argon/htdocs/luci-static/argon/css/cascade.css
--- a/package/community/luci-theme-argon/htdocs/luci-static/argon/css/cascade.css
+++ b/package/community/luci-theme-argon/htdocs/luci-static/argon/css/cascade.css
@@ -7436,6 +7436,8 @@
 #cbi-dockerd .cbi-section.cbi-tblsection {
   padding: 0;
 }
+[data-page="admin-services-dockerman"] #docker_apply_overlay,
+[data-page^="admin-services-dockerman-"] #docker_apply_overlay,
 [data-page="admin-docker"] #docker_apply_overlay,
 [data-page^="admin-docker-"] #docker_apply_overlay {
   position: fixed;
@@ -7444,6 +7446,8 @@
   overflow-y: auto;
   overscroll-behavior: contain;
 }
+[data-page="admin-services-dockerman"] #docker_apply_overlay > .alert-message,
+[data-page^="admin-services-dockerman-"] #docker_apply_overlay > .alert-message,
 [data-page="admin-docker"] #docker_apply_overlay > .alert-message,
 [data-page^="admin-docker-"] #docker_apply_overlay > .alert-message {
   position: static;
@@ -7457,12 +7461,16 @@
   margin: auto;
   overflow: auto;
 }
+[data-page="admin-services-dockerman"] #docker_apply_overlay > .alert-message > span,
+[data-page^="admin-services-dockerman-"] #docker_apply_overlay > .alert-message > span,
 [data-page="admin-docker"] #docker_apply_overlay > .alert-message > span,
 [data-page^="admin-docker-"] #docker_apply_overlay > .alert-message > span {
   flex: 1 1 0;
   min-width: 0;
   max-width: 100%;
 }
+[data-page="admin-services-dockerman"].apply-overlay-active #docker_apply_overlay,
+[data-page^="admin-services-dockerman-"].apply-overlay-active #docker_apply_overlay,
 [data-page="admin-docker"].apply-overlay-active #docker_apply_overlay,
 [data-page^="admin-docker-"].apply-overlay-active #docker_apply_overlay {
   display: flex;
