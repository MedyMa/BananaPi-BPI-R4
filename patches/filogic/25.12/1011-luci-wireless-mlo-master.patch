+// MLO for a wifi-iface: wifi-scripts turns `option mlo '1'` into hostapd's
+// mld_ap=1, which needs an EHT radio and hostapd built with 11BE.  htmode is a
+// radio property, so read it here rather than name it in a depends().
+function mlo_available(dev, section_id) {
+	if (!L.hasSystemFeature('hostapd', '11be'))
+		return false;
+
+	const freq = this.map.lookupOption('_freq', dev);
+	const htmode = freq ? freq[0].formvalue(dev)?.[0] : uci.get('wireless', dev, 'htmode');
+
+	return /^EHT/.test(htmode || '');
+}
