From: MedyMa <75345465+MedyMa@users.noreply.github.com>
Subject: [PATCH] mt_wifi7: use generic unaligned header on Linux 6.12

The architecture-specific asm/unaligned.h wrapper is no longer available in
Linux 6.12. Include the generic header that provides get_unaligned() instead.

--- a/mt_wifi/include/os/rt_linux.h
+++ b/mt_wifi/include/os/rt_linux.h
@@ -50,7 +50,7 @@
 #include <linux/unistd.h>
 #include <asm/uaccess.h>
 #include <asm/types.h>
-#include <asm/unaligned.h>	/* for get_unaligned() */
+#include <linux/unaligned.h>	/* for get_unaligned() */
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(2, 6, 27)
 #include <linux/pid.h>
