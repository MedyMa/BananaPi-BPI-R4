From: CI Fix <ci@build.local>
Date: Thu, 17 Jul 2026 00:00:00 +0800
Subject: [PATCH] hostapd: stub out incomplete MLO code in sae_accept_sta() for
 802.11be build

Upstream hostapd commit ca266cc2 ("2025-08-26 snapshot") has
ieee802_11.c referencing mld_assoc_link_id and mld_info members
that do not yet exist in struct sta_info.  The MTK vendor WiFi7
driver handles MLO at the firmware level, so hostapd's MLO path
in sae_accept_sta() is not needed.

This is a minimal alternative to adding the missing struct fields
(see 804-hostapd-add-mld-sta-info-fields.patch for the other
approach).

--- a/src/ap/ieee802_11.c
+++ b/src/ap/ieee802_11.c
@@ -1163,12 +1163,18 @@ static u16 sae_accept_sta(struct hostapd
 	 * bitmap for generated IGTK/IGTK keyid.
 	 */
 #ifdef CONFIG_IEEE80211BE
+#if 0 /* mld_assoc_link_id and mld_info not yet in struct sta_info */
 	if (ap_sta_is_mld(hapd, sta)) {
 		u8 link_id = sta->mld_assoc_link_id;
 
 		pmksa_addr = sta->mld_info.common_info.mld_addr;
 		pmksa_link_addr = sta->mld_info.links[link_id].peer_addr;
 	}
+#else
+	/*
+	 * MTK vendor WiFi7 firmware handles MLO; skip hostapd MLO path.
+	 */
+#endif
 #endif /* CONFIG_IEEE80211BE */
 
 	pmksa = pmksa_cache_auth_get(hapd->wpa_auth, pmksa_addr, pmksa_link_addr,
