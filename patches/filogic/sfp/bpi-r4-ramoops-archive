#!/bin/sh /etc/rc.common
# Archive the previous boot's kernel log (pstore/ramoops) early in this boot.
#
# ramoops lives in DRAM: it survives a warm reset, but the console ring keeps
# being overwritten by this boot's own output, and a power cycle erases it
# completely.  Copying it out at START=00 - before the rest of the boot has
# produced much output, and while the overlay is already mounted - means the log
# of a failed warm reboot is still readable after the router is power cycled.
#
# Read it back with:
#   ls -l /root/pstore-archive/ ; cat /root/pstore-archive/*/dmesg-ramoops-*
#
# When there is nothing to save (no warm reset since the last boot) this is a
# no-op.

START=00

PSTORE_DIR=/sys/fs/pstore
ARCHIVE_DIR=/root/pstore-archive
MAX_KEEP=3

start() {
	local ts dst count oldest

	[ -d "$PSTORE_DIR" ] || return 0
	mountpoint -q "$PSTORE_DIR" 2>/dev/null || \
		mount -t pstore pstore "$PSTORE_DIR" 2>/dev/null || return 0

	# pstore only lists entries when something was actually recorded.
	ls "$PSTORE_DIR"/* >/dev/null 2>&1 || return 0

	mkdir -p "$ARCHIVE_DIR" || return 0
	# At START=00 the clock may not be set yet (no NTP), so fall back to the PID
	# rather than letting every failure overwrite the same 1970-01-01 directory.
	ts=$(date +%Y%m%d-%H%M%S 2>/dev/null)
	case "$ts" in
		''|1970*|19[0-9][0-9]*) ts="boot-$$" ;;
	esac
	dst="$ARCHIVE_DIR/$ts"
	mkdir -p "$dst" || return 0
	cp -f "$PSTORE_DIR"/* "$dst"/ 2>/dev/null

	count=$(ls -1 "$ARCHIVE_DIR" 2>/dev/null | wc -l)
	while [ "$count" -gt "$MAX_KEEP" ]; do
		oldest=$(ls -1 "$ARCHIVE_DIR" 2>/dev/null | head -n 1)
		[ -n "$oldest" ] || break
		rm -rf "$ARCHIVE_DIR/$oldest"
		count=$((count - 1))
	done

	logger -t ramoops-archive "saved previous boot log to $dst ($(ls -1 "$dst" 2>/dev/null | wc -l) file(s))"
}

stop() {
	:
}
