From: BPI-R4 HNAT Fix
Date: Sun, 27 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: mediatek: fix CPU-to-WiFi HNAT GSO ordering and flow control

CPU-to-WiFi HNAT has two interrelated problems:

1. GSO ordering: QDMA hardware TSO interleaves consecutive GSO batches
   on the PPE/WED output path, creating TCP sequence holes of exactly
   44 segments (one batch). Client-side captures show valid checksums
   within each batch but complete batches swapped.

2. Flow control bypass: HNAT pushes packets directly to PPE which feeds
   WiFi DMA descriptors, bypassing mt76's three-layer flow control
   (per-queue q->queued, per-station non_aql_packets, global token
   budget). This causes silent drops under load.

Fix: Force software GSO segmentation on the CPU-to-WiFi PPE reinjection
path. Non-GSO packets (UDP games, DNS, small TCP) still use the HNAT
fast path. GSO packets are segmented via skb_gso_segment() before PPE
submission — each wire-sized segment gets its HNAT descriptor and
cb[44] PPE metadata rebuilt, since GSO allocates fresh skb heads.

After segmentation, the QDMA hardware only sees wire-sized packets,
eliminating batch interleaving. Wire-sized bursts are also less likely
to overflow WiFi DMA rings, mitigating (though not fully fixing) the
flow control issue.

The Ethernet header has already been pulled when the bridge local-out
hook runs. Push it back before skb_gso_segment() so every segment
inherits correct L2 addresses. Use skb_cow_head() instead of the
original skb_cow() so cloned headers can be safely modified.

On segmentation error, consume the original skb — returning it to the
bridge path would reuse an skb whose MAC header and control block have
already been used as GSO workspace.

Signed-off-by: BPI-R4 HNAT Fix
---
 drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c | 148 +++++++++++++++++------
 1 file changed, 108 insertions(+), 40 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -26,6 +26,7 @@
 #include <net/netfilter/nf_conntrack.h>
 #include <net/netfilter/nf_conntrack_acct.h>
 #include <linux/stddef.h>
+#include <net/gso.h>
 
 #include "nf_hnat_mtk.h"
 #include "hnat.h"
@@ -953,42 +954,107 @@
 	return 0;
 }
 
+/* Submit a single wire-sized skb to PPE for CPU-to-WiFi HNAT.
+ * Called both for non-GSO packets and for individual GSO segments.
+ * Rebuilds HNAT head descriptor and cb[44] PPE metadata because
+ * GSO allocates fresh skb heads that lack these vendor fields.
+ */
+static void hnat_cpu_to_ge_xmit(struct sk_buff *skb)
+{
+	u16 vlan_id = skb_vlan_tag_get_id(skb);
+
+	if (unlikely(vlan_id)) {
+		skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
+		if (!skb)
+			return;
+	}
+
+	/* vlan_insert_tag() may replace skb->head.  Initialize the vendor
+	 * metadata only after it, so every segment queued to PPE owns a valid
+	 * descriptor at the beginning of its current head allocation.
+	 */
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN))) {
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
+	skb_hnat_alg(skb) = 0;
+	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
+	skb_hnat_filled(skb) = 0;
+	set_to_ppe(skb);
+
+	/* Set where the reinjected packet came from. */
+	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q),
+			       VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
+	skb->dev = hnat_priv->g_ppdev;
+	dev_queue_xmit(skb);
+}
+
 static unsigned int do_hnat_cpu_to_ge(struct sk_buff *skb)
 {
+	struct sk_buff *segs, *seg, *next;
+	netdev_features_t features;
+
 	if (unlikely(skb_shinfo(skb)->frag_list))
-                return -1;
-        if (unlikely(skb_headroom(skb) < (FOE_INFO_LEN + ETH_HLEN))) {
-                if(unlikely(skb_cow(skb, FOE_INFO_LEN + ETH_HLEN)))
-                return -1;
-        }
+		return -1;
+	if (unlikely(skb_cow_head(skb, FOE_INFO_LEN + ETH_HLEN)))
+		return -1;
 
+	memset(skb_hnat_info(skb), 0, FOE_INFO_LEN);
 	skb_hnat_alg(skb) = 0;
 	skb_hnat_magic_tag(skb) = HNAT_MAGIC_TAG;
 	skb_hnat_filled(skb) = 0;
 
 	if (unlikely(!is_ppe_support_type(skb))) {
-                skb_hnat_alg(skb) = 1;
-                return -1;
-        }
-        if (hnat_priv->g_ppdev && hnat_priv->g_ppdev->flags & IFF_UP) {
-                u16 vlan_id = 0;
-                skb_set_network_header(skb, 0);
-                skb_push(skb, ETH_HLEN);
-		set_to_ppe(skb);
-                vlan_id = skb_vlan_tag_get_id(skb);
-                if (unlikely(vlan_id)) {
-                        skb = vlan_insert_tag(skb, skb->vlan_proto, skb->vlan_tci);
-                        if (!skb)
-                                return -1;
-                }
-
-                /*set where we come from */
-                __vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q), VLAN_CFI_MASK | (1234 & VLAN_VID_MASK));
-                skb->dev = hnat_priv->g_ppdev;
-                dev_queue_xmit(skb);
-     		return 0;
-        }
-	return -1;
+		skb_hnat_alg(skb) = 1;
+		return -1;
+	}
+
+	if (unlikely(!hnat_priv->g_ppdev) ||
+	    unlikely(!(hnat_priv->g_ppdev->flags & IFF_UP)))
+		return -1;
+
+	/* The bridge hook has pulled the Ethernet header.  Put it back before
+	 * GSO so skb_segment() copies real L2 bytes into every new skb.
+	 */
+	skb_set_network_header(skb, 0);
+	skb_push(skb, ETH_HLEN);
+	skb_reset_mac_header(skb);
+	skb_reset_mac_len(skb);
+
+	if (!skb_is_gso(skb)) {
+		hnat_cpu_to_ge_xmit(skb);
+		return 0;
+	}
+
+	/* QDMA/PPE/WED can reorder consecutive hardware-TSO batches.
+	 * Produce wire-sized skbs here while retaining SG and checksum
+	 * offload.  GSO uses skb->cb[32..47] and allocates fresh skb
+	 * heads, so the transmit helper deliberately restores both
+	 * MediaTek metadata areas after segmentation.
+	 */
+	features = hnat_priv->g_ppdev->features & ~NETIF_F_GSO_MASK;
+	segs = skb_gso_segment(skb, features);
+	if (IS_ERR(segs)) {
+		pr_warn_ratelimited("HNAT: CPU-to-WiFi GSO segmentation failed: %ld\n",
+				    PTR_ERR(segs));
+		dev_kfree_skb_any(skb);
+		return 0;
+	}
+
+	if (!segs) {
+		hnat_cpu_to_ge_xmit(skb);
+		return 0;
+	}
+
+	consume_skb(skb);
+	skb_list_walk_safe(segs, seg, next) {
+		skb_mark_not_on_list(seg);
+		hnat_cpu_to_ge_xmit(seg);
+	}
+
+	return 0;
 }
 
 static void mtk_hnat_nf_update(struct sk_buff *skb)
