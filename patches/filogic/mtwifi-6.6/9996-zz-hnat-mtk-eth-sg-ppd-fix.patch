From: BPI-R4 HNAT Fix
Date: Wed, 29 Jul 2026 00:00:00 +0000
Subject: [PATCH] net: mediatek: preserve PPE state per descriptor and RX packet

mtk_tx_map() clears txd_info for every scatter-gather fragment. Preserve
ext_ppe across that reset so mtk_tx_set_dma_desc_v2() routes every
descriptor of a CPU-to-WiFi packet to PPE.

Keep sent_ppd inside the RX loop so one packet cannot leak its PPD state
into a later packet handled by the same NAPI poll.

Depends: 9996-ext-hnat.patch
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -1845,6 +1845,7 @@ static int mtk_tx_map(struct sk_buff *sk
 	struct mtk_tx_dma *itxd, *txd;
 	struct mtk_tx_dma *itxd_pdma, *txd_pdma;
 	struct mtk_tx_buf *itx_buf, *tx_buf;
+	bool hnat_to_ppe = txd_info.ext_ppe;
 	int i, n_desc = 1;
 	int queue = skb_get_queue_mapping(skb);
 	int k = 0;
@@ -1898,6 +1899,7 @@ static int mtk_tx_map(struct sk_buff *sk
 			txd_info.size = min_t(unsigned int, frag_size,
 					      soc->tx.dma_max_len);
 			txd_info.qid = queue;
+			txd_info.ext_ppe = hnat_to_ppe;
 			txd_info.last = i == skb_shinfo(skb)->nr_frags - 1 &&
 					!(frag_size - txd_info.size);
 			txd_info.addr = skb_frag_dma_map(eth->dma_dev, frag,
@@ -2449,7 +2451,6 @@ static int mtk_poll_rx(struct napi_struc
 	int done = 0, bytes = 0;
 	dma_addr_t dma_addr = DMA_MAPPING_ERROR;
 	int ppe_idx = 0;
-	int sent_ppd = 0;
 
 	if (unlikely(!ring))
 		goto rx_done;
@@ -2459,6 +2460,7 @@ static int mtk_poll_rx(struct napi_struc
 		struct net_device *netdev;
 		u32 hash, reason;
 		int mac = 0;
+		bool sent_ppd = false;
 
 		idx = NEXT_DESP_IDX(ring->calc_idx, ring->dma_size);
 		rxd = ring->dma + idx * eth->soc->rx.desc_size;
-- 
