-function radioFeature(option, prefixes, modes) {
+function radioFeature(option, prefixes, modes, device) {
+	// Interface options depend on the radio's frequency widget, not a
+	// same-name field in the wifi-iface section. Use a fully qualified ID.
+	const field = device ? 'wireless.%s._freq'.format(device) : '_freq';
 	for (const prefix of prefixes)
 		for (const width of [20, 40, 80, 160, 320]) {
 			if (width == 320 && prefix != 'EHT') continue;
-			for (const mode of modes || ['']) {
-				const dependency = { '_freq': prefix + width, '!contains': true };
-				if (mode) dependency.mode = mode;
-				option.depends(dependency);
-			}
+			const suffixes = width == 320 ? ['', '-1', '-2'] : [''];
+			for (const suffix of suffixes)
+				for (const mode of modes || ['']) {
+					const dependency = { [field]: prefix + width + suffix, '!contains': true };
+					if (mode) dependency.mode = mode;
+					option.depends(dependency);
+				}
 		}
 	return option;
 }
