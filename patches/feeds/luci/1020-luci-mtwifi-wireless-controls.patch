+		uci.set('wireless', owner, 'whnat', value);
+	};
+	o.remove = function(id) { this.write(id, this.enabled); };
+}
+
+function addIfaceOptions(section, id, radioNet) {
+	add_mlo_interface_option(section, id, radioNet);
+	for (const [key, title] of [
+		['mumimo_dl', _('MU-MIMO DL')], ['mumimo_ul', _('MU-MIMO UL')],
+		['ofdma_dl', _('OFDMA DL')], ['ofdma_ul', _('OFDMA UL')],
+		['amsdu', _('A-MSDU')], ['autoba', _('Auto Block ACK')], ['uapsd', _('U-APSD')]
+	]) {
+		const o = profileOption(section, key, title);
+		if (['mumimo_dl', 'mumimo_ul', 'ofdma_dl', 'ofdma_ul'].includes(key))
+			radioFeature(o, ['HE', 'EHT'], ['ap', 'ap-wds']);
+		else {
+			o.depends('mode', 'ap');
+			o.depends('mode', 'ap-wds');
+		}
+	}
+	for (const [key, title, datatype, placeholder] of [
+		['kicklow', _('Kick low RSSI station threshold'), 'range(-100,0)', '0'],
+		['assocthres', _('Station associate threshold'), 'range(-100,0)', '0'],
+		['frag', _('Fragmentation Threshold'), 'range(256,2346)', '2346'],
+		['rts', _('RTS/CTS Threshold'), 'range(0,2347)', '2347']
+	]) {
+		const o = section.taboption('advanced', form.Value, key, title);
+		o.datatype = datatype;
+		o.placeholder = placeholder;
+		o.optional = true;
+		o.depends('mode', 'ap');
+		o.depends('mode', 'ap-wds');
+	}
+}
+
+function handleSaveApply(view, ev, mode, fallback) {
+	if (!mlo_pending_action) return fallback();
+	if (mode != '0' || mlo_pending_changes()) {
+		mlo_pending_action = null;
+		ui.addNotification(null, E('p', _('Apply other wireless changes first, then reopen the interface to manage MLO.')));
+		return fallback();
+	}
+	const pending = mlo_pending_action;
+	ui.showModal(_('Applying MLO changes'), E('p', { 'class': 'spinning' }, _('Please wait…')));
+	return mlo_rpc('/usr/sbin/mtwifi-mlo-control', pending.action, pending.payload).then(result =>
+		result.pending ? mlo_wait_for_operation(result.id || pending.payload.id, 360) : result
+	).then(result => {
+		mlo_pending_action = null;
+		if (result.state == 'rolled_back')
+			ui.addNotification(null, E('p', _('MLO could not be applied; the previous wireless settings were restored.')));
+		window.location.reload();
+	}).catch(error => { mlo_pending_action = null; mlo_show_save_error(error); });
+}
+
+return baseclass.extend({
+	addDeviceOptions, addIfaceOptions, handleSaveApply,
+	cancel: function() { mlo_pending_action = null; }
+});
