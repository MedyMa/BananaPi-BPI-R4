+++ b/feeds/luci/modules/luci-mod-network/htdocs/luci-static/resources/tools/mtwifi.js
@@ -4,6 +4,68 @@
 'require ui';
 'require uci';
 'require form';
+'require network';
+
+
+let runtimeCapabilities = {};
+
+function supportsApVlan(radio) {
+	return runtimeCapabilities[radio]?.ap_vlan === true;
+}
+
+function hasVlanSettings(id) {
+	return +uci.get('wireless', id, 'dynamic_vlan') > 0 ||
+		uci.get('wireless', id, 'per_sta_vif') == '1';
+}
+
+function validateVlan(id, value) {
+	const radio = uci.get('wireless', id, 'device');
+	return supportsApVlan(radio) || !+value ||
+		_('This wireless driver does not support dynamic or per-station VLANs.');
+}
+
+function loadCapabilities() {
+	if (!uci.sections('wireless', 'wifi-device').some(radio => radio.type == 'mtwifi'))
+		return Promise.resolve();
+	const messages = {
+		DRIVER_REBUILD_PENDING: _('Wireless devices are being rebuilt. Connections may briefly disconnect.'),
+		DRIVER_REBUILD_FAILED: _('Wireless rebuild failed. Check the wireless status before retrying.'),
+		DRIVER_RESTART_REQUIRED: _('This change requires restarting the wireless driver.'),
+		AP_VLAN_NOT_SUPPORTED: _('This wireless driver does not support dynamic or per-station VLANs.')
+	};
+	for (const [code, message] of Object.entries(messages))
+		network.registerErrorCode(code, message);
+	return fs.exec('/sbin/l1util', ['capabilities']).then(result => {
+		if (result.code != 0) throw new Error('capabilities unavailable');
+		const data = JSON.parse(result.stdout);
+		runtimeCapabilities = data.radios || {};
+		if (data.rebuild?.phase == 'failed') {
+			const content = [ E('p', {}, data.rebuild.recovered ?
+				_('Wireless rebuild failed; the previous configuration has been restored.') :
+				_('Wireless rebuild failed; manual recovery is required.')) ];
+			if (L.hasViewPermission())
+				content.push(E('button', {
+					'class': 'btn cbi-button-action',
+					'click': ui.createHandlerFn(null, function(ev) {
+						if (mlo_has_pending_wireless_changes()) {
+							ui.addNotification(null, E('p', {}, _('Apply or discard other wireless changes before retrying.')), 'warning');
+							return;
+						}
+						const button = ev.currentTarget;
+						button.disabled = true;
+						return fs.exec('/sbin/wifi', ['rebuild']).then(result => {
+							if (result.code != 0) throw new Error('retry failed');
+							ui.addNotification(null, E('p', {}, _('Wireless rebuild requested. Refresh the wireless status shortly.')), 'info');
+						}).catch(() => {
+							button.disabled = false;
+							ui.addNotification(null, E('p', {}, _('Could not request a wireless rebuild.')), 'error');
+						});
+					})
+				}, _('Retry')));
+			ui.addNotification(null, E('div', {}, content), 'warning');
+		}
+	}).catch(() => { runtimeCapabilities = {}; });
+}
 
 // MTK private controls and the existing transactional MLO manager.
 function mlo_error_text(code) {
@@ -786,5 +848,6 @@ function handleSaveApply(view, ev, mode, fallback) {
 
